# Copy this file to .env (in the repo root) and fill in the blanks.
# All three apps (web, gateway, workers) read this one file. KEYS.md explains every value.

# ---- Database and Redis (defaults match docker-compose.yml) ----
DATABASE_URL=postgres://handsup:handsup@localhost:5432/handsup
REDIS_URL=redis://localhost:6379

# ---- Auth.js (teacher sign-in) ----
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=
# Google OAuth client (see README, "Google sign-in")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed when the app is reached through anything other than localhost
AUTH_TRUST_HOST=true
# The address teachers sign in on. Google only accepts addresses you listed in the OAuth client.
# Leave empty to use NEXT_PUBLIC_APP_URL. Locally: http://localhost:3000
AUTH_URL=

# Lets you sign in as a test teacher without Google. Only works in development.
ALLOW_DEV_LOGIN=true

# ---- Realtime gateway ----
# Shared secret the web app uses to sign teacher tokens and the gateway uses to check them.
# Generate with: openssl rand -base64 32
REALTIME_SECRET=
GATEWAY_PORT=4000
# Comma-separated list of origins allowed to open sockets. Leave empty in development to allow all.
CORS_ORIGINS=

# Where browsers find the gateway. Leave empty in development: the browser then uses
# the same host it loaded the page from, on port 4000 (this makes phones on Wi-Fi work).
NEXT_PUBLIC_GATEWAY_URL=

# The address put in the QR code. For testing with a real phone, set this to your
# computer's Wi-Fi address, e.g. http://192.168.1.23:3000 (see README).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- AI (optional: without these, alerts and reports are written by rules instead) ----
# Live insights and question-group names. Free key: https://console.groq.com → API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# After-class report summary. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local models for grouping questions and reading their tone (download once, ~90 MB, into .cache/models).
# Set to "off" to skip the download and use the simpler word-based grouping.
LOCAL_MODELS=on

# ---- Error tracking (optional) ----
# From sentry.io → Project → Settings → Client Keys (DSN). Leave empty to turn off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
