{
  "name": "@handsup/gateway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx --env-file=../../.env scripts/simulate.ts"
  },
  "dependencies": {
    "@handsup/db": "workspace:*",
    "@handsup/server": "workspace:*",
    "@handsup/shared": "workspace:*",
    "@sentry/node": "10.22.0",
    "@socket.io/redis-adapter": "8.3.0",
    "ioredis": "5.8.2",
    "jose": "5.10.0",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "socket.io-client": "4.8.1",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}